# Set the Slack pair, DISCORD_WEBHOOK_URL, or both. At least one destination is required.

# Slack Bot OAuth Token (xoxb-...). Set together with CHANNEL_ID.
SLACK_API_TOKEN=xoxb-your-token-here

# Slack channel ID to post to (e.g. C01234ABCDE). Set together with SLACK_API_TOKEN.
CHANNEL_ID=C01234ABCDE

# Discord incoming webhook URL for the channel to post to
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000/xxxxxxxx

# Optional: Hour of day to post (24h, JST). Default: 10
POSTING_HOUR=10
